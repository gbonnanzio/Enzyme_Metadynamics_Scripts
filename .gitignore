HILLS
COLVAR
grid.dat
bck.*

# Generated analysis products and job logs
analysis/
*.png
prep.txt
analysis.txt
slurm_ids

# Keep the small bundled ligand params under classical_md/prep even though
# the global *.inpcrd/*.prmtop rules would otherwise ignore them.
!classical_md/prep/DON.prmtop
!classical_md/prep/DON.inpcrd
