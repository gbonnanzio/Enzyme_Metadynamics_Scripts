Heating 0 -> 300 K, NVT
&cntrl
  imin=0,                              ! run dynamics
  irest=0,                             ! new run, do not read velocities from the restart
  ntx=1,                               ! read coordinates only from the inpcrd/restart
  nstlim=200000,                       ! 200,000 steps = 200 ps at 1 fs
  dt=0.001,                            ! timestep, ps (1 fs)
  ntc=2,                               ! SHAKE: constrain bonds involving hydrogen
  ntf=2,                               ! skip force evaluation for those constrained bonds
  ntt=3,                               ! Langevin thermostat
  gamma_ln=5.0,                        ! Langevin collision frequency, 1/ps
  tempi=0.0,                           ! starting temperature, K
  temp0=300.0,                         ! target temperature, K (ramped by the &wt block)
  nmropt=1,                            ! enable the &wt blocks below (needed for the ramp)
  ntb=1,                               ! periodic boundaries, constant volume
  ntp=0,                               ! no pressure coupling during heating
  cut=9.0,                             ! nonbonded cutoff, Angstrom
  ntr=1,                               ! positional restraints on
  restraintmask=':1-1117&!@H=',        ! restrain all solute heavy atoms while heating
  restraint_wt=10.0,                   ! restraint force constant, kcal/mol/Angstrom^2
  ntwx=5000,                           ! write a trajectory frame every 5000 steps (5 ps)
  ntpr=1000,                           ! write energies to mdout every 1000 steps
  ntwr=10000,                          ! write a restart file every 10,000 steps
  ig=-1,                               ! random seed from the clock (independent replicates)
&end
&wt type='TEMP0', istep1=0, istep2=200000, value1=0.0, value2=300.0 /   ! linear T ramp
&wt type='END' /                                                        ! end of &wt blocks
